APP_ENV=development
APP_DEBUG=true

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=beluga
DB_USERNAME=root
DB_PASSWORD=

JWT_SECRET=cambia_este_secreto_en_produccion

CORS_ORIGIN=http://localhost:5173

# Zona horaria del negocio. De esto depende qué día es "hoy" para cobros, mora y
# pizarrón. No se hereda del php.ini a propósito: local y hosting difieren.
APP_TIMEZONE=America/Mexico_City

# ── Tickets ───────────────────────────────────────────────────────────────────
# No requieren configuración: el comprobante se imprime desde el navegador con
# el diálogo de impresión (papel de 58 mm). El servidor no habla con la
# impresora, así que instalar el sistema en otro equipo no exige nada extra.
