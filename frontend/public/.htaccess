Options -Indexes
RewriteEngine On

# Block direct access to backend internals (only public/index.php is reachable internally)
RewriteRule ^backend/(?!public/index\.php$) - [F,L]

# Route all /api/* requests to PHP backend
RewriteRule ^api/ backend/public/index.php [QSA,L]

# SPA fallback — serve index.html for client-side routes
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
